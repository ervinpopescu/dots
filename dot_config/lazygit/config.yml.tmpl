os:
  copyToClipboardCmd: "sh -c 'printf \"\\033]52;c;$(printf {{ `{{text}}` }} | base64 -w 0)\\a\" > /dev/tty'"
git:
  overrideGpg: true

{{- if .is_cloudtop }}
gui:
  wrapLinesInStagingView: true
customCommands:
  - key: "P"
    description: "Push local branch(es) to remote (multi-select with fzf)"
    context: "localBranches"
    output: "terminal"
    prompts:
      - type: "menuFromCommand"
        title: "Which remote repository to push to?"
        key: "Remote"
        command: bash -c "git remote --verbose | grep '/.* (push)'"
        filter: '(?P<remote>.*)\s+(?P<url>.*) \(push\)'
        valueFormat: "{{ `{{ .remote }}` }}"
        labelFormat: "{{ `{{ .remote | bold | cyan }} {{ .url }}` }}"
      - type: "menu"
        title: "How to push?"
        key: "PushMode"
        options:
          - value: "push"
          - value: "push --force-with-lease"
          - value: "push --force"
    command: >-
      bash -c '
      mapfile -t branches < <((echo "{{ `{{.SelectedLocalBranch.Name}}` }}"; git for-each-ref --format="%(refname:short)" refs/heads/ | grep -vFx "{{ `{{.SelectedLocalBranch.Name}}` }}" || true) | fzf --multi --prompt="Push to {{ `{{.Form.Remote}}` }} > " --header="TAB: toggle | Ctrl-A: all | ENTER: push | ESC: cancel");
      if [ ${#branches[@]} -eq 0 ] || [ -z "${branches[0]}" ]; then
        echo "No branch selected.";
        exit 0;
      fi;
      echo "Pushing ${#branches[@]} branch(es) to {{ `{{.Form.Remote}}` }} ({{ `{{.Form.PushMode}}` }})...";
      printf "  • %s\n" "${branches[@]}";
      echo "";
      if git {{ `{{.Form.PushMode}}` }} {{ `{{.Form.Remote}}` }} "${branches[@]}"; then
        echo "";
        read -t 3 -n 1 -s -r -p "Pushed successfully. Press any key to return (or wait 3s)..." || true;
      else
        echo "";
        read -n 1 -s -r -p "Push failed. Press any key to return to lazygit..." || true;
        exit 1;
      fi'
{{- end }}
