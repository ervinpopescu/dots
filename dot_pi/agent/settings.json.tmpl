    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:@narumitw/pi-plan-mode",
    "npm:pi-add-dir",
    "npm:pi-interactive-shell",
    "npm:@trevonistrevon/pi-loop",
    "npm:pi-input-history"
