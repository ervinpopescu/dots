{{- $destPath := joinPath .chezmoi.homeDir ".pi/agent/settings.json" -}}
{{- $currentVersion := "0.87.1" -}}
{{- if stat $destPath -}}
  {{- $current := include $destPath | fromJson -}}
  {{- if hasKey $current "lastChangelogVersion" -}}
    {{- $currentVersion = get $current "lastChangelogVersion" -}}
  {{- end -}}
{{- end -}}
{
  "autocompleteMaxVisible": 15,
  "collapseChangelog": true,
{{- if .is_cloudtop }}
  "enabledModels": [
    "google/gemini-3.8-flash:high"
  ],
{{- else }}
  "enabledModels": [
    "openai-codex/gpt-5.6-sol:high",
    "antigravity/gemini-4-hydrogen:high",
    "antigravity/claude-opus-4-6-thinking:high"
  ],
{{- end }}
{{- if .is_cloudtop }}
  "defaultModel": "gemini-3.8-flash",
  "defaultProvider": "google",
{{- else }}
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai-codex",
{{- end }}
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "lastChangelogVersion": {{ $currentVersion | quote }},
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:@narumitw/pi-plan-mode",
    "npm:pi-add-dir",
    "npm:pi-interactive-shell",
    "npm:@trevonistrevon/pi-loop",
    "npm:pi-input-history"
{{- if not .is_cloudtop }},
    "npm:pi-claude-bridge",
    "npm:pi-effort",
    "git:github.com/DietrichGebert/ponytail",
    "npm:@estebanforge/pi-antigravity-bridge"
{{- end }}
  ],
  "quietStartup": true,
  "subagents": {
{{- if .is_cloudtop }}
    "defaultModel": "google/gemini-3.8-flash:high",
    "defaultProvider": "google",
    "defaultThinking": "high"
{{- else }}
    "defaultModel": "openai-codex/gpt-5.6-luna:high",
    "defaultProvider": "openai-codex",
    "defaultThinking": "high",
    "agentOverrides": {
      "worker": {
        "model": "openai-codex/gpt-6-luna:high"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna:high"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-luna:high"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol:high"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna:high"
      }
    },
    "agentOverridesByProvider": {
      "google": {
        "worker": {
          "model": "antigravity/gemini-4-hydrogen",
          "thinking": "high"
        }
      }
    }
{{- end }}
  },
  "theme": "dark"
{{- if not .is_cloudtop }},
  "extensions": [
    "-builtin:mcp"
  ],
  "pi-effort": {
    "modelEffort": {
      "claude-bridge/claude-opus-5-5": "medium"
    }
  }
{{- end }}
}
