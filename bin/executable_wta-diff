#!/bin/bash
# ==============================================================================
# Worktree Diff Runner
# ==============================================================================
# Diffs all non-main worktree branches against a given remote (default: no-mistakes).

REMOTE=${1:-no-mistakes}

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: Must be run inside a git repository." >&2
  exit 1
fi

RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
BOLD='\033[1m'
RESET='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
ORIGINAL_DIR="$(pwd)"

# Retrieve worktree directories safely
worktrees=()
while IFS= read -r line; do
  path=$(echo "$line" | awk '{print $1}')
  # Exclude the main worktree and any path matching the main branch
  if [[ "$path" != "$REPO_ROOT" && ! "$line" =~ \[main\]$ ]]; then
    worktrees+=("$path")
  fi
done < <(git -C "$REPO_ROOT" worktree list)

if [ ${#worktrees[@]} -eq 0 ]; then
  echo "No non-main worktrees found."
  exit 0
fi

for wk in "${worktrees[@]}"; do
  cd "$wk" 2>/dev/null || continue

  branch="$(git branch --show-current)"

  # Make the branch name highly visible using ANSI colors
  echo -e "${BLUE}${BOLD}======================================================================${RESET}"
  echo -e "${BLUE}${BOLD}==============  ${YELLOW}${BOLD}${branch:-detached HEAD} ${BLUE}${BOLD} ==============${RESET}"
  echo -e "${BLUE}${BOLD}======================================================================${RESET}"
  echo

  if [ -n "$branch" ]; then
    if git rev-parse --verify -q "$REMOTE/$branch" >/dev/null; then
      # Using --color=always provides native syntax highlighting, so you likely
      # won't even need to pipe it into bat/cat -ldiff anymore.
      GIT_PAGER='' git diff --color=always "$branch" "$REMOTE/$branch"
    else
      echo -e "${RED}Warning: Remote branch '$REMOTE/$branch' does not exist.${RESET}"
    fi
  fi
  echo
done

cd "$ORIGINAL_DIR" || exit 0
