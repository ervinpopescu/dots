#!/usr/bin/env python3
"""cycle-deploy-branches - Repo-agnostic worktree cycle deployer with local state tracking.

Cycles through all git worktrees (excluding main), runs configured deployment
and verification steps, and manages local persistent state.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from typing import Any, Dict, List, Optional, Tuple


# ==============================================================================
# ANSI Color & Formatting Utilities
# ==============================================================================
class Colors:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    CYAN = "\033[1;36m"
    GREEN = "\033[1;32m"
    RED = "\033[1;31m"
    YELLOW = "\033[1;33m"
    MAGENTA = "\033[1;35m"

    @classmethod
    def disable(cls) -> None:
        cls.RESET = ""
        cls.BOLD = ""
        cls.DIM = ""
        cls.CYAN = ""
        cls.GREEN = ""
        cls.RED = ""
        cls.YELLOW = ""
        cls.MAGENTA = ""


if not sys.stdout.isatty():
    Colors.disable()


# ==============================================================================
# Git Helpers
# ==============================================================================
def get_git_output(cmd: List[str], cwd: Optional[str] = None) -> str:
    try:
        return subprocess.check_output(cmd, cwd=cwd, text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return ""


def get_main_repo() -> Optional[str]:
    is_tree = get_git_output(["git", "rev-parse", "--is-inside-work-tree"])
    if not is_tree:
        return None

    common = get_git_output(["git", "rev-parse", "--git-common-dir"])
    if common:
        candidate = os.path.realpath(os.path.join(common, ".."))
        if os.path.isdir(candidate):
            return candidate

    toplevel = get_git_output(["git", "rev-parse", "--show-toplevel"])
    if toplevel:
        return os.path.realpath(toplevel)

    return None


def get_git_common_dir(main_repo: str) -> Optional[str]:
    common = get_git_output(["git", "-C", main_repo, "rev-parse", "--git-common-dir"])
    if common:
        if os.path.isabs(common):
            return os.path.realpath(common)
        return os.path.realpath(os.path.join(main_repo, common))

    git_dir = get_git_output(["git", "-C", main_repo, "rev-parse", "--git-dir"])
    if git_dir:
        if os.path.isabs(git_dir):
            return os.path.realpath(git_dir)
        return os.path.realpath(os.path.join(main_repo, git_dir))

    return None


def list_worktrees(main_repo: str) -> List[Dict[str, Any]]:
    out = get_git_output(["git", "-C", main_repo, "worktree", "list", "--porcelain"])
    if not out:
        return []

    worktrees: List[Dict[str, Any]] = []
    curr: Dict[str, Any] = {}
    main_canonical = os.path.realpath(main_repo)

    for line in out.strip().split("\n"):
        if not line:
            if curr:
                worktrees.append(curr)
                curr = {}
            continue
        parts = line.split(" ", 1)
        k = parts[0]
        v = parts[1] if len(parts) > 1 else ""
        if k == "worktree":
            curr["worktree"] = os.path.realpath(v)
        elif k == "HEAD":
            curr["commit"] = v
            curr["commit_short"] = v[:8]
        elif k == "branch":
            curr["branch"] = v.replace("refs/heads/", "")

    if curr:
        worktrees.append(curr)

    # Exclude primary main repo worktree
    filtered = [w for w in worktrees if w.get("worktree") != main_canonical]

    for w in filtered:
        commit = w.get("commit", "")
        msg = get_git_output(["git", "-C", w["worktree"], "log", "-1", "--format=%s", commit])
        w["commit_msg"] = msg

    return filtered


def get_commit_difference(worktree: str, saved_commit: str, current_commit: str) -> str:
    if not saved_commit:
        return "-"
    if saved_commit == current_commit:
        return "synced"
    try:
        count = subprocess.check_output(
            ["git", "-C", worktree, "rev-list", "--count", f"{saved_commit}..{current_commit}"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
        return f"+{count} commits" if count != "0" else "synced"
    except Exception:
        return "diff"


# ==============================================================================
# Environment & String Expansion
# ==============================================================================
def expand_template(template: str, env: Dict[str, str]) -> str:
    """Expands ${VAR:-default}, ${VAR}, and $VAR against env dictionary."""

    def replace_braced(match: re.Match) -> str:
        var_name = match.group(1)
        has_default = match.group(2) is not None
        default_val = match.group(3) if has_default else ""
        val = env.get(var_name, "")
        if not val:
            return default_val if has_default else ""
        return val

    # Expand ${VAR:-default} or ${VAR}
    s = re.sub(r"\$\{([A-Za-z0-9_]+)(:-([^}]*))?\}", replace_braced, template)

    # Expand remaining $VAR using os.path.expandvars with current env
    old_environ = os.environ.copy()
    try:
        os.environ.update(env)
        s = os.path.expandvars(s)
    finally:
        os.environ.clear()
        os.environ.update(old_environ)

    return s


# ==============================================================================
# Configuration Management
# ==============================================================================
def find_config_file(
    main_repo: str,
    worktree: Optional[str] = None,
    custom_path: Optional[str] = None,
) -> Optional[str]:
    candidates: List[str] = []
    if custom_path:
        candidates.append(os.path.abspath(custom_path))
    if worktree:
        candidates.append(os.path.join(worktree, ".cycle-deploy.json"))
        candidates.append(os.path.join(worktree, ".cycle-deploy.sh"))
    if main_repo:
        candidates.append(os.path.join(main_repo, ".cycle-deploy.json"))
        candidates.append(os.path.join(main_repo, ".cycle-deploy.sh"))

    for c in candidates:
        if os.path.isfile(c):
            return c
    return None


class Config:

    def __init__(self, raw: Dict[str, Any], config_path: str, main_repo: str) -> None:
        self.config_path = config_path
        self.main_repo = main_repo
        self.name: str = raw.get("name", os.path.basename(main_repo) if main_repo else "project")
        self.raw_env: Dict[str, str] = (
            raw.get("env", {}) if isinstance(raw.get("env"), dict) else {}
        )
        self.sync: List[Dict[str, str]] = []
        self._parse_sync(raw.get("sync", []))
        self.steps: List[Dict[str, Any]] = self._parse_steps(raw.get("steps", []))
        self.post_deploy: List[Dict[str, Any]] = self._parse_steps(raw.get("post_deploy", []))
        self.manual_test: Dict[str, Any] = self._parse_manual_test(raw.get("manual_test", {}))
        self.test_plan: Dict[str, Any] = self._parse_test_plan(raw.get("test_plan"))
        self.state_file: str = raw.get("state_file", "")

    def _parse_sync(self, raw_sync: Any) -> None:
        if isinstance(raw_sync, list):
            for item in raw_sync:
                if isinstance(item, str):
                    self.sync.append({"src": item, "dest": item})
                elif isinstance(item, dict):
                    src = item.get("src") or item.get("from") or ""
                    dest = item.get("dest") or item.get("to") or src
                    if src:
                        self.sync.append({"src": src, "dest": dest})

    @staticmethod
    def _parse_steps(raw_steps: Any) -> List[Dict[str, Any]]:
        steps: List[Dict[str, Any]] = []
        if isinstance(raw_steps, list):
            for s in raw_steps:
                if isinstance(s, dict) and "command" in s:
                    steps.append(
                        {
                            "name": s.get("name", s["command"]),
                            "command": s["command"],
                            "optional": bool(s.get("optional", False)),
                            "condition": s.get("condition", ""),
                        }
                    )
                elif isinstance(s, str):
                    steps.append(
                        {
                            "name": s,
                            "command": s,
                            "optional": False,
                            "condition": "",
                        }
                    )
        return steps

    @staticmethod
    def _parse_manual_test(raw_mt: Any) -> Dict[str, Any]:
        if isinstance(raw_mt, dict):
            return {
                "enabled": bool(raw_mt.get("enabled", True)),
                "title": raw_mt.get("title", "Manual Testing Phase"),
                "info": raw_mt.get("info", []) if isinstance(raw_mt.get("info"), list) else [],
                "instructions": (
                    raw_mt.get("instructions", [])
                    if isinstance(raw_mt.get("instructions"), list)
                    else []
                ),
            }
        return {
            "enabled": True,
            "title": "Manual Testing Phase",
            "info": [],
            "instructions": [],
        }

    @staticmethod
    def _parse_test_plan(raw_tp: Any) -> Dict[str, Any]:
        default_files = [
            "PR_MESSAGE.md",
            "TEST_PLAN.md",
            "TESTING.md",
            "docs/TEST_PLAN.md",
            "docs/TESTING.md",
            "docs/test_plan.md",
        ]
        if isinstance(raw_tp, dict):
            files = raw_tp.get("files")
            if isinstance(files, str):
                files_list = [files]
            elif isinstance(files, list):
                files_list = [str(f) for f in files if f]
            else:
                files_list = default_files
            section = raw_tp.get("section")
            return {
                "files": files_list,
                "section": str(section).strip() if section else "",
            }
        elif isinstance(raw_tp, list):
            return {
                "files": [str(f) for f in raw_tp if f],
                "section": "",
            }
        elif isinstance(raw_tp, str) and raw_tp.strip():
            return {
                "files": [raw_tp.strip()],
                "section": "",
            }
        return {
            "files": default_files,
            "section": "",
        }

    def build_env(self, base_env: Optional[Dict[str, str]] = None) -> Dict[str, str]:
        env = dict(os.environ)
        if base_env:
            env.update(base_env)

        for k, v in self.raw_env.items():
            env[k] = expand_template(str(v), env)
        return env


def load_config(config_path: str, main_repo: str) -> Config:
    if not os.path.isfile(config_path):
        sys.stderr.write(f"❌ Error: Config file not found: {config_path}\n")
        sys.exit(1)

    if config_path.endswith(".sh"):
        return Config(
            {
                "name": os.path.basename(main_repo) if main_repo else "project",
                "env": {},
                "sync": [],
                "steps": [],
                "post_deploy": [],
                "manual_test": {
                    "enabled": True,
                    "title": "Manual Testing Phase",
                    "info": [],
                    "instructions": [],
                },
                "test_plan": {
                    "files": [
                        "PR_MESSAGE.md",
                        "TEST_PLAN.md",
                        "TESTING.md",
                        "docs/TEST_PLAN.md",
                        "docs/TESTING.md",
                        "docs/test_plan.md",
                    ],
                    "section": "",
                },
                "state_file": "",
            },
            config_path,
            main_repo,
        )

    try:
        with open(config_path, "r", encoding="utf-8") as f:
            raw = json.load(f)
    except Exception as e:
        sys.stderr.write(f"❌ Error: Failed to parse configuration JSON '{config_path}': {e}\n")
        sys.exit(1)

    if not isinstance(raw, dict):
        sys.stderr.write(f"❌ Error: Config file '{config_path}' root must be a JSON object.\n")
        sys.exit(1)

    return Config(raw, config_path, main_repo)


def extract_branch_test_plan(
    worktree: str, test_plan_config: Dict[str, Any]
) -> Optional[Tuple[str, str]]:
    """Extract a branch-specific testing plan from candidate files in the worktree.

    Returns (relative_file_path, plan_content) or None.
    Uses purely Python standard library operations (zero subprocesses).
    """
    candidate_files = test_plan_config.get("files") or [
        "PR_MESSAGE.md",
        "TEST_PLAN.md",
        "TESTING.md",
        "docs/TEST_PLAN.md",
        "docs/TESTING.md",
        "docs/test_plan.md",
    ]
    target_section = test_plan_config.get("section", "").strip()

    default_heading_patterns = [
        re.compile(
            r"^(#{1,6})\s+(?:(?:\d+\.|\*|-)\s+)?(testing\s*plan|test\s*plan)\b",
            re.IGNORECASE,
        ),
        re.compile(
            r"^(#{1,6})\s+(?:(?:\d+\.|\*|-)\s+)?(manual\s*verif\w*)\b",
            re.IGNORECASE,
        ),
        re.compile(
            r"^(#{1,6})\s+(?:(?:\d+\.|\*|-)\s+)?(verif\w*|testing)\b",
            re.IGNORECASE,
        ),
    ]

    custom_pattern = None
    if target_section:
        escaped_section = re.escape(target_section)
        custom_pattern = re.compile(
            rf"^(#{{1,6}})\s+(?:(?:\d+\.|\*|-)\s+)?.*{escaped_section}.*",
            re.IGNORECASE,
        )

    for rel_path in candidate_files:
        full_path = os.path.join(worktree, rel_path)
        if not os.path.isfile(full_path):
            continue

        try:
            with open(full_path, "r", encoding="utf-8", errors="replace") as f:
                content = f.read()
        except Exception:
            continue

        lines = content.splitlines()

        def find_section(pattern: re.Pattern) -> Optional[str]:
            for idx, line in enumerate(lines):
                m = pattern.match(line)
                if m:
                    heading_level = len(m.group(1))
                    collected: List[str] = []
                    for next_line in lines[idx + 1 :]:
                        m_next = re.match(r"^(#{1,6})\s+", next_line)
                        if m_next and len(m_next.group(1)) <= heading_level:
                            break
                        collected.append(next_line)
                    res = "\n".join(collected).strip()
                    if res:
                        return res
            return None

        # 1. If custom section was requested, check it first
        if custom_pattern:
            plan = find_section(custom_pattern)
            if plan:
                return (rel_path, plan)

        # 2. Check default heading patterns
        for pat in default_heading_patterns:
            plan = find_section(pat)
            if plan:
                return (rel_path, plan)

        # 3. If file is specifically a dedicated test plan document, use full content
        base_lower = os.path.basename(rel_path).lower()
        if base_lower in (
            "test_plan.md",
            "testplan.md",
            "testing.md",
            "test-plan.md",
            "tests.md",
        ):
            cleaned = content.strip()
            if cleaned:
                return (rel_path, cleaned)

    return None


# ==============================================================================
# State File Management
# ==============================================================================
def resolve_state_file_path(
    main_repo: str,
    git_common_dir: Optional[str],
    cfg_state_file: Optional[str],
) -> str:
    if cfg_state_file:
        if os.path.isabs(cfg_state_file):
            return cfg_state_file
        return os.path.abspath(os.path.join(main_repo, cfg_state_file))

    if git_common_dir and os.path.isdir(git_common_dir):
        return os.path.join(git_common_dir, "cycle-deploy-state.json")

    return os.path.join(main_repo, ".cycle-deploy-state.json")


def get_iso_timestamp() -> str:
    return (
        datetime.datetime.now(datetime.timezone.utc)
        .isoformat(timespec="seconds")
        .replace("+00:00", "Z")
    )


class StateManager:

    def __init__(self, state_file_path: str, repo_name: str) -> None:
        self.state_file_path = state_file_path
        self.repo_name = repo_name

    def load(self) -> Dict[str, Any]:
        if not os.path.isfile(self.state_file_path):
            return {"repo": self.repo_name, "last_updated": "", "branches": {}}
        try:
            with open(self.state_file_path, "r", encoding="utf-8") as f:
                data = json.load(f)
                if not isinstance(data, dict):
                    return {"repo": self.repo_name, "last_updated": "", "branches": {}}
                if "branches" not in data or not isinstance(data["branches"], dict):
                    data["branches"] = {}
                return data
        except Exception:
            return {"repo": self.repo_name, "last_updated": "", "branches": {}}

    def save(self, data: Dict[str, Any]) -> None:
        dir_name = os.path.dirname(os.path.abspath(self.state_file_path))
        os.makedirs(dir_name, exist_ok=True)
        with tempfile.NamedTemporaryFile("w", dir=dir_name, delete=False, encoding="utf-8") as tf:
            json.dump(data, tf, indent=2)
            tf.write("\n")
            temp_name = tf.name
        os.replace(temp_name, self.state_file_path)

    def get_branch_state(self, branch: str) -> Dict[str, Any]:
        data = self.load()
        return data.get("branches", {}).get(branch, {})

    def update_branch(
        self,
        branch: str,
        status: str,
        commit: str,
        commit_short: str,
        commit_msg: str,
        worktree: str,
        duration_seconds: int = 0,
        failed_step: Optional[str] = None,
        exit_code: int = 0,
        steps: Optional[List[Dict[str, Any]]] = None,
    ) -> None:
        data = self.load()
        if self.repo_name and not data.get("repo"):
            data["repo"] = self.repo_name
        data["last_updated"] = get_iso_timestamp()

        record = {
            "status": status,
            "commit": commit,
            "commit_short": commit_short,
            "commit_msg": commit_msg,
            "timestamp": get_iso_timestamp(),
            "worktree": worktree,
            "duration_seconds": int(duration_seconds),
            "failed_step": failed_step if failed_step else None,
            "exit_code": int(exit_code),
            "steps": steps or [],
        }
        data["branches"][branch] = record
        self.save(data)

    def clear(self) -> None:
        data = {
            "repo": self.repo_name,
            "last_updated": get_iso_timestamp(),
            "branches": {},
        }
        self.save(data)


# ==============================================================================
# Overview Status Display
# ==============================================================================
ANSI_REGEX = re.compile(r"\x1b\[[0-9;]*m")


def visible_len(s: str) -> int:
    return len(ANSI_REGEX.sub("", s))


def ansi_ljust(s: str, width: int) -> str:
    vlen = visible_len(s)
    pad = max(0, width - vlen)
    return s + (" " * pad)


def print_status_table(
    state_manager: StateManager,
    main_repo: str,
    worktrees: List[Dict[str, Any]],
    test_plan_config: Optional[Dict[str, Any]] = None,
) -> None:
    state_data = state_manager.load()
    branches_state = state_data.get("branches", {})

    status_map = {
        "passed": f"{Colors.GREEN}✓ PASSED{Colors.RESET}",
        "deployed": f"{Colors.GREEN}✓ PASSED{Colors.RESET}",
        "failed": f"{Colors.RED}❌ FAILED{Colors.RESET}",
        "skipped": f"{Colors.YELLOW}⚠ SKIPPED{Colors.RESET}",
        "in_progress": f"{Colors.CYAN}⏳ RUNNING{Colors.RESET}",
        "pending": f"{Colors.DIM}⚪ PENDING{Colors.RESET}",
    }

    print(
        f"\n{Colors.BOLD}{Colors.CYAN}========================================================================================================{Colors.RESET}"
    )
    print(
        f"{Colors.BOLD}                                      DEPLOYMENT STATUS OVERVIEW                                        {Colors.RESET}"
    )
    print(
        f"{Colors.BOLD}{Colors.CYAN}========================================================================================================{Colors.RESET}"
    )
    print(f"{Colors.DIM}Repository:  {main_repo}{Colors.RESET}")
    print(f"{Colors.DIM}State File:  {state_manager.state_file_path}{Colors.RESET}")
    if state_data.get("last_updated"):
        print(f"{Colors.DIM}Last Update: {state_data['last_updated']}{Colors.RESET}")
    print("")

    h_branch, h_status, h_commit, h_sync, h_time, h_detail = (
        "BRANCH",
        "STATUS",
        "COMMIT",
        "SYNC",
        "LAST RUN",
        "DETAIL",
    )
    print(
        f"  {Colors.BOLD}{h_branch:<44} {h_status:<14} {h_commit:<10} {h_sync:<13} {h_time:<19} {h_detail}{Colors.RESET}"
    )
    print("  " + "-" * 102)

    t_passed = 0
    t_failed = 0
    t_skipped = 0
    t_pending = 0

    for w in worktrees:
        branch = w.get("branch", "")
        current_commit = w.get("commit", "")
        current_short = w.get("commit_short", "")
        b_info = branches_state.get(branch, None)

        if b_info:
            raw_status = b_info.get("status", "pending")
            saved_commit = b_info.get("commit", "")
            raw_time = b_info.get("timestamp", "-")
            time_str = raw_time.replace("T", " ")[:16] if "T" in raw_time else raw_time[:16]
            failed_step = b_info.get("failed_step", "")
            detail = (
                failed_step
                if failed_step
                else (
                    f"{b_info.get('duration_seconds', 0)}s"
                    if raw_status in ("passed", "deployed")
                    else ""
                )
            )

            if raw_status in ("passed", "deployed"):
                t_passed += 1
            elif raw_status == "failed":
                t_failed += 1
            elif raw_status == "skipped":
                t_skipped += 1
            else:
                t_pending += 1

            disp_status = status_map.get(raw_status, f"{Colors.DIM}{raw_status}{Colors.RESET}")
            sync_stat = get_commit_difference(w["worktree"], saved_commit, current_commit)
            if sync_stat == "synced":
                disp_sync = f"{Colors.GREEN}synced{Colors.RESET}"
            elif sync_stat.startswith("+"):
                disp_sync = f"{Colors.YELLOW}{sync_stat}{Colors.RESET}"
            else:
                disp_sync = sync_stat
        else:
            t_pending += 1
            disp_status = status_map["pending"]
            disp_sync = "-"
            time_str = "-"
            detail = ""

        if not detail and test_plan_config:
            wt_path = w.get("worktree", "")
            if wt_path:
                tp = extract_branch_test_plan(wt_path, test_plan_config)
                if tp:
                    detail = f"{Colors.DIM}plan: {tp[0]}{Colors.RESET}"

        disp_branch = branch if len(branch) <= 44 else branch[:41] + "..."
        col_branch = ansi_ljust(disp_branch, 44)
        col_status = ansi_ljust(disp_status, 14)
        col_commit = ansi_ljust(current_short, 10)
        col_sync = ansi_ljust(disp_sync, 13)
        col_time = ansi_ljust(time_str, 19)

        print(f"  {col_branch} {col_status} {col_commit} {col_sync} {col_time} {detail}")

    print("  " + "-" * 102)
    print(
        f"  {Colors.BOLD}Total Worktrees: {len(worktrees)}{Colors.RESET} | "
        f"{Colors.GREEN}Passed: {t_passed}{Colors.RESET} | "
        f"{Colors.RED}Failed: {t_failed}{Colors.RESET} | "
        f"{Colors.YELLOW}Skipped: {t_skipped}{Colors.RESET} | "
        f"{Colors.DIM}Pending: {t_pending}{Colors.RESET}\n"
    )


