#!/bin/bash
# ==============================================================================
# Worktree Test Runner
# ==============================================================================
# This script runs `make setup` and `make test` across all non-main git worktrees
# in the current repository, reporting the status for each.

# Check that we are inside a git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: Must be run inside a git repository." >&2
  exit 1
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
ORIGINAL_DIR="$(pwd)"

# Retrieve worktree directories safely
worktrees=()
while IFS= read -r line; do
  path=$(echo "$line" | awk '{print $1}')
  # Exclude the main worktree and any path matching the main branch
  if [[ "$path" != "$REPO_ROOT" && ! "$line" =~ \[main\]$ ]]; then
    worktrees+=("$path")
  fi
done < <(git -C "$REPO_ROOT" worktree list)

if [ ${#worktrees[@]} -eq 0 ]; then
  echo "No non-main worktrees found."
  exit 0
fi

for wk in "${worktrees[@]}"; do
  cd "$wk" 2>/dev/null || continue

  branch="$(git branch --show-current)"
  echo -e "${YELLOW}Branch:${RESET} ${branch:-detached HEAD}"

  if ! make setup >/dev/null 2>&1; then
    echo -e "${RED}setup failed${RESET}"
    echo "==========================================================================="
    continue
  fi

  if make test >/dev/null 2>&1; then
    echo -e "${GREEN}test passed${RESET}"
  else
    echo -e "${RED}test failed${RESET}"
  fi

  echo "==========================================================================="
done

cd "$ORIGINAL_DIR" || exit 0
